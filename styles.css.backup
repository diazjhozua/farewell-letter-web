* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: 'Arial', sans-serif;
    margin: 0;
    padding: 0;
    overflow: hidden;
}

body.trailer-mode {
    background: #000;
    overflow: hidden;
}

body.letter-mode {
    background: #000;
    overflow: hidden;
}

/* ================================
   THEME SYSTEM
   ================================ */

/* DEFAULT THEME (Current Blue/Purple) */
.theme-default .trailer-background {
    background: linear-gradient(135deg, #1e3c72 0%, #2a5298 50%, #667eea 100%);
    opacity: 0.95;
}

.theme-default .letters-background {
    background: linear-gradient(135deg, #1e3c72 0%, #2a5298 50%, #667eea 100%);
    opacity: 0.95;
}

.theme-default .letter-from {
    color: #1e3c72;
    text-shadow: 0 2px 8px rgba(30, 60, 114, 0.3);
    font-family: 'Brush Script MT', cursive, Georgia, serif;
}

.theme-default .letter-from:hover {
    color: #2a5298;
    text-shadow: 0 4px 12px rgba(42, 82, 152, 0.4);
}

.theme-default .letter-from::after {
    background: linear-gradient(90deg,
        transparent,
        rgba(30, 60, 114, 0.2),
        rgba(30, 60, 114, 0.6),
        rgba(42, 82, 152, 0.8),
        rgba(30, 60, 114, 0.6),
        rgba(30, 60, 114, 0.2),
        transparent
    );
}

.theme-default .letter-paper {
    background: linear-gradient(145deg, rgba(255, 253, 250, 0.98), rgba(250, 248, 245, 0.95));
    box-shadow:
        0 25px 70px rgba(0, 0, 0, 0.4),
        0 15px 35px rgba(0, 0, 0, 0.25),
        inset 0 0 0 1px rgba(255, 255, 255, 0.4),
        inset 0 1px 0 rgba(255, 255, 255, 0.6);
    color: #2c1810;
}

.theme-default .letter-paper:hover {
    box-shadow:
        0 30px 80px rgba(0, 0, 0, 0.45),
        0 20px 40px rgba(0, 0, 0, 0.3),
        inset 0 0 0 1px rgba(255, 255, 255, 0.5),
        inset 0 1px 0 rgba(255, 255, 255, 0.7);
}

.theme-default .letter-message {
    color: #3e2723;
}

.theme-default .letter-greeting,
.theme-default .letter-closing {
    color: #5d4037;
}

/* TECH/PROGRAMMER THEME */
.theme-tech .trailer-background {
    background: linear-gradient(135deg, #0d1117 0%, #21262d 50%, #161b22 100%);
    opacity: 0.98;
}

.theme-tech .letters-background {
    background: linear-gradient(135deg, #0d1117 0%, #21262d 50%, #161b22 100%);
    opacity: 0.98;
}

.theme-tech .intro-title,
.theme-tech .trailer-counter,
.theme-tech .letters-counter,
.theme-tech .trailer-nav-btn,
.theme-tech .letters-nav-btn {
    font-family: 'Courier New', 'Monaco', monospace;
}

.theme-tech .letter-paper {
    background: linear-gradient(145deg, rgba(13, 17, 23, 0.95), rgba(33, 38, 45, 0.92));
    border: 1px solid rgba(0, 255, 0, 0.2);
    box-shadow: 0 0 30px rgba(0, 255, 0, 0.1);
    color: #c9d1d9;
}

.theme-tech .letter-paper:hover {
    box-shadow: 0 0 40px rgba(0, 255, 0, 0.2);
    border-color: rgba(0, 255, 0, 0.4);
}

.theme-tech .letter-from {
    color: #00ff00;
    font-family: 'Courier New', monospace;
    text-shadow: 0 0 10px rgba(0, 255, 0, 0.5);
    font-weight: 700;
}

.theme-tech .letter-from:hover {
    color: #39ff14;
    text-shadow: 0 0 15px rgba(57, 255, 20, 0.7);
}

.theme-tech .letter-from::after {
    background: linear-gradient(90deg,
        transparent,
        rgba(0, 255, 0, 0.3),
        rgba(0, 255, 0, 0.8),
        rgba(57, 255, 20, 1),
        rgba(0, 255, 0, 0.8),
        rgba(0, 255, 0, 0.3),
        transparent
    );
}

.theme-tech .letter-message {
    color: #c9d1d9;
    font-family: 'Courier New', monospace;
}

.theme-tech .letter-greeting,
.theme-tech .letter-closing {
    color: #58a6ff;
}

/* BUSINESS THEME */
.theme-business .trailer-background {
    background: linear-gradient(135deg, #1a365d 0%, #2c5282 50%, #3182ce 100%);
    opacity: 0.96;
}

.theme-business .letters-background {
    background: linear-gradient(135deg, #1a365d 0%, #2c5282 50%, #3182ce 100%);
    opacity: 0.96;
}

.theme-business .letter-paper {
    background: linear-gradient(145deg, rgba(255, 255, 255, 0.98), rgba(248, 250, 252, 0.95));
    border: 2px solid rgba(49, 130, 206, 0.1);
    box-shadow: 0 20px 60px rgba(26, 54, 93, 0.15);
    color: #1a202c;
}

.theme-business .letter-paper:hover {
    box-shadow: 0 25px 70px rgba(26, 54, 93, 0.2);
    border-color: rgba(49, 130, 206, 0.2);
}

.theme-business .letter-from {
    color: #1a365d;
    font-family: 'Times New Roman', serif;
    font-weight: 600;
    text-shadow: none;
}

.theme-business .letter-from:hover {
    color: #2c5282;
}

.theme-business .letter-from::after {
    background: linear-gradient(90deg,
        transparent,
        rgba(26, 54, 93, 0.3),
        rgba(26, 54, 93, 0.7),
        rgba(44, 82, 130, 0.9),
        rgba(26, 54, 93, 0.7),
        rgba(26, 54, 93, 0.3),
        transparent
    );
}

.theme-business .intro-title {
    font-family: 'Times New Roman', serif;
    font-weight: 400;
}

.theme-business .letter-message {
    font-family: 'Times New Roman', serif;
    color: #1a202c;
}

.theme-business .letter-greeting,
.theme-business .letter-closing {
    color: #2c5282;
    font-weight: 600;
}

/* GIRLY THEME */
.theme-girly .trailer-background {
    background: linear-gradient(135deg, #ec4899 0%, #be185d 50%, #f472b6 100%);
    opacity: 0.93;
}

.theme-girly .letters-background {
    background: linear-gradient(135deg, #ec4899 0%, #be185d 50%, #f472b6 100%);
    opacity: 0.93;
}

.theme-girly .letter-paper {
    background: linear-gradient(145deg, rgba(255, 242, 249, 0.97), rgba(253, 230, 245, 0.94));
    border: 2px solid rgba(236, 72, 153, 0.2);
    box-shadow: 0 25px 70px rgba(236, 72, 153, 0.2);
    border-radius: 20px;
    color: #831843;
}

.theme-girly .letter-paper:hover {
    box-shadow: 0 30px 80px rgba(236, 72, 153, 0.25);
    border-color: rgba(236, 72, 153, 0.3);
}

.theme-girly .letter-from {
    color: #be185d;
    font-family: 'Brush Script MT', cursive;
    text-shadow: 0 2px 10px rgba(190, 24, 93, 0.3);
}

.theme-girly .letter-from:hover {
    color: #ec4899;
    text-shadow: 0 4px 15px rgba(236, 72, 153, 0.5);
}

.theme-girly .letter-from::after {
    background: linear-gradient(90deg,
        transparent,
        rgba(236, 72, 153, 0.3),
        rgba(236, 72, 153, 0.7),
        rgba(190, 24, 93, 0.9),
        rgba(236, 72, 153, 0.7),
        rgba(236, 72, 153, 0.3),
        transparent
    );
}

.theme-girly .intro-title {
    font-family: 'Brush Script MT', cursive;
}

.theme-girly .letter-message {
    color: #831843;
    font-family: 'Georgia', serif;
}

.theme-girly .letter-greeting,
.theme-girly .letter-closing {
    color: #be185d;
    font-style: italic;
}

/* FUTURISTIC THEME */
.theme-futuristic .trailer-background {
    background: linear-gradient(135deg, #0f0f23 0%, #1a1a2e 50%, #16213e 100%);
    opacity: 0.97;
}

.theme-futuristic .letters-background {
    background: linear-gradient(135deg, #0f0f23 0%, #1a1a2e 50%, #16213e 100%);
    opacity: 0.97;
}

.theme-futuristic .letter-paper {
    background: linear-gradient(145deg, rgba(15, 15, 35, 0.95), rgba(26, 26, 46, 0.92));
    border: 2px solid rgba(0, 255, 255, 0.3);
    box-shadow:
        0 0 40px rgba(0, 255, 255, 0.2),
        inset 0 0 20px rgba(0, 255, 255, 0.05);
    border-radius: 10px;
    color: #a0a9c0;
}

.theme-futuristic .letter-paper:hover {
    box-shadow:
        0 0 50px rgba(0, 255, 255, 0.3),
        0 0 25px rgba(255, 0, 255, 0.1),
        inset 0 0 25px rgba(0, 255, 255, 0.08);
    border-color: rgba(0, 255, 255, 0.5);
}

.theme-futuristic .letter-from {
    color: #00ffff;
    font-family: 'Orbitron', 'Arial Black', sans-serif;
    text-shadow: 0 0 15px rgba(0, 255, 255, 0.8);
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 2px;
}

.theme-futuristic .letter-from:hover {
    color: #ff00ff;
    text-shadow: 0 0 20px rgba(255, 0, 255, 0.9);
}

.theme-futuristic .letter-from::after {
    background: linear-gradient(90deg,
        transparent,
        rgba(0, 255, 255, 0.4),
        rgba(0, 255, 255, 0.8),
        rgba(255, 0, 255, 1),
        rgba(0, 255, 255, 0.8),
        rgba(0, 255, 255, 0.4),
        transparent
    );
    height: 2px;
    animation: neonPulse 2s ease-in-out infinite;
}

@keyframes neonPulse {
    0%, 100% {
        opacity: 0.7;
        box-shadow: 0 0 5px rgba(0, 255, 255, 0.5);
    }
    50% {
        opacity: 1;
        box-shadow: 0 0 15px rgba(0, 255, 255, 0.8);
    }
}

.theme-futuristic .intro-title {
    font-family: 'Orbitron', sans-serif;
    text-transform: uppercase;
    letter-spacing: 3px;
}

.theme-futuristic .letter-message {
    color: #a0a9c0;
    font-family: 'Arial', sans-serif;
}

.theme-futuristic .letter-greeting,
.theme-futuristic .letter-closing {
    color: #00ffff;
    font-family: 'Orbitron', sans-serif;
    text-transform: uppercase;
}

/* Theme-specific UI Elements */

/* Default Theme UI */
.theme-default .letters-progress-fill {
    background: linear-gradient(90deg, rgba(30, 60, 114, 0.8), rgba(42, 82, 152, 0.9));
}

.theme-default .trailer-progress-fill {
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.8), rgba(255, 255, 255, 1));
}

/* Tech Theme UI */
.theme-tech .letters-progress-fill {
    background: linear-gradient(90deg, rgba(0, 255, 0, 0.6), rgba(57, 255, 20, 0.9));
    box-shadow: 0 0 10px rgba(0, 255, 0, 0.5);
}

.theme-tech .trailer-progress-fill {
    background: linear-gradient(90deg, rgba(0, 255, 0, 0.6), rgba(57, 255, 20, 0.9));
    box-shadow: 0 0 10px rgba(0, 255, 0, 0.5);
}

.theme-tech .trailer-nav-btn,
.theme-tech .letters-nav-btn {
    border-color: rgba(0, 255, 0, 0.6);
    background: rgba(0, 255, 0, 0.1);
}

.theme-tech .trailer-nav-btn:hover,
.theme-tech .letters-nav-btn:hover {
    border-color: #00ff00;
    background: rgba(0, 255, 0, 0.2);
    box-shadow: 0 0 20px rgba(0, 255, 0, 0.3);
}

/* Business Theme UI */
.theme-business .letters-progress-fill {
    background: linear-gradient(90deg, rgba(26, 54, 93, 0.8), rgba(44, 82, 130, 0.9));
}

.theme-business .trailer-progress-fill {
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.8), rgba(255, 255, 255, 1));
}

.theme-business .trailer-nav-btn,
.theme-business .letters-nav-btn {
    border-color: rgba(26, 54, 93, 0.6);
    background: rgba(26, 54, 93, 0.1);
}

.theme-business .trailer-nav-btn:hover,
.theme-business .letters-nav-btn:hover {
    border-color: #1a365d;
    background: rgba(26, 54, 93, 0.2);
}

/* Girly Theme UI */
.theme-girly .letters-progress-fill {
    background: linear-gradient(90deg, rgba(236, 72, 153, 0.8), rgba(190, 24, 93, 0.9));
}

.theme-girly .trailer-progress-fill {
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.8), rgba(255, 255, 255, 1));
}

.theme-girly .trailer-nav-btn,
.theme-girly .letters-nav-btn {
    border-color: rgba(236, 72, 153, 0.6);
    background: rgba(236, 72, 153, 0.1);
}

.theme-girly .trailer-nav-btn:hover,
.theme-girly .letters-nav-btn:hover {
    border-color: #ec4899;
    background: rgba(236, 72, 153, 0.2);
    box-shadow: 0 0 20px rgba(236, 72, 153, 0.3);
}

/* Futuristic Theme UI */
.theme-futuristic .letters-progress-fill {
    background: linear-gradient(90deg, rgba(0, 255, 255, 0.6), rgba(255, 0, 255, 0.9));
    box-shadow: 0 0 15px rgba(0, 255, 255, 0.5);
}

.theme-futuristic .trailer-progress-fill {
    background: linear-gradient(90deg, rgba(0, 255, 255, 0.6), rgba(255, 0, 255, 0.9));
    box-shadow: 0 0 15px rgba(0, 255, 255, 0.5);
}

.theme-futuristic .trailer-nav-btn,
.theme-futuristic .letters-nav-btn {
    border-color: rgba(0, 255, 255, 0.6);
    background: rgba(0, 255, 255, 0.1);
}

.theme-futuristic .trailer-nav-btn:hover,
.theme-futuristic .letters-nav-btn:hover {
    border-color: #00ffff;
    background: rgba(0, 255, 255, 0.2);
    box-shadow: 0 0 25px rgba(0, 255, 255, 0.4);
}

/* Trailer Mode Styles */
.trailer-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    color: white;
    overflow: hidden;
}

.trailer-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    /* Background set by theme classes */
}

.trailer-background::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background:
        radial-gradient(circle at 20% 80%, rgba(120, 120, 120, 0.1) 0%, transparent 50%),
        radial-gradient(circle at 80% 20%, rgba(255, 255, 255, 0.1) 0%, transparent 50%),
        radial-gradient(circle at 40% 40%, rgba(255, 255, 255, 0.05) 0%, transparent 50%);
    animation: shimmer 8s ease-in-out infinite alternate;
}

@keyframes shimmer {
    0% { opacity: 0.5; }
    100% { opacity: 1; }
}

.trailer-content {
    width: 100%;
    max-width: 800px;
    text-align: center;
    padding: 40px;
    z-index: 10;
}

.trailer-slide {
    transition: all 0.8s ease-in-out;
    padding: 20px;
}

/* Trailer Content Styling */
.trailer-container .intro-icon {
    font-size: 6rem;
    margin-bottom: 30px;
    display: block;
    text-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
    animation: float 3s ease-in-out infinite;
}

@keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-10px); }
}

.trailer-container .intro-title {
    font-size: 3rem;
    font-weight: 300;
    margin-bottom: 30px;
    text-transform: uppercase;
    letter-spacing: 3px;
    text-shadow: 0 0 30px rgba(255, 255, 255, 0.5);
    line-height: 1.2;
}

.trailer-container .intro-text {
    font-size: 1.4rem;
    line-height: 1.8;
    max-width: 600px;
    margin: 0 auto;
    opacity: 0.9;
    text-shadow: 0 0 10px rgba(0, 0, 0, 0.3);
    font-weight: 300;
}

/* Trailer Navigation */
.trailer-navigation {
    position: absolute;
    bottom: 120px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 30px;
}

.trailer-nav-btn {
    width: 60px;
    height: 60px;
    border: 2px solid rgba(255, 255, 255, 0.6);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: white;
    font-size: 1.8rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
}

.trailer-nav-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: white;
    transform: scale(1.1);
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
}

.trailer-nav-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
    transform: none;
}

.trailer-counter {
    background: rgba(255, 255, 255, 0.1);
    padding: 12px 24px;
    border-radius: 30px;
    font-weight: 600;
    font-size: 1.1rem;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
}

/* Trailer Progress Bar */
.trailer-progress-bar {
    position: absolute;
    bottom: 80px;
    left: 50%;
    transform: translateX(-50%);
    width: 300px;
    height: 4px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 2px;
    overflow: hidden;
}

.trailer-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, rgba(255, 255, 255, 0.8), rgba(255, 255, 255, 1));
    transition: width 0.5s ease;
    border-radius: 2px;
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
}

/* Trailer Transition Button */
.trailer-transition-button {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
}

.trailer-transition-button .start-letters-btn {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.2), rgba(255, 255, 255, 0.3));
    color: white;
    border: 2px solid rgba(255, 255, 255, 0.6);
    padding: 18px 40px;
    border-radius: 50px;
    font-size: 1.2rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    backdrop-filter: blur(15px);
    text-transform: uppercase;
    letter-spacing: 1px;
}

.trailer-transition-button .start-letters-btn:hover {
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.3), rgba(255, 255, 255, 0.4));
    border-color: white;
    transform: translateY(-3px);
    box-shadow: 0 10px 30px rgba(255, 255, 255, 0.3);
}

/* Skip Intro Button */
.skip-intro-button {
    position: absolute;
    top: 30px;
    right: 30px;
}

.skip-intro-btn {
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 10px 20px;
    border-radius: 25px;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
}

.skip-intro-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    color: white;
    border-color: rgba(255, 255, 255, 0.6);
}

/* Trailer Instructions */
.trailer-instructions {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.9rem;
}

/* Letters Mode Styles - Matching Trailer Theme */
.letters-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 1000;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    color: white;
    overflow: hidden;
}

.letters-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    /* Background set by theme classes */
}

.letters-background::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background:
        radial-gradient(circle at 30% 70%, rgba(120, 120, 120, 0.1) 0%, transparent 50%),
        radial-gradient(circle at 70% 30%, rgba(255, 255, 255, 0.1) 0%, transparent 50%),
        radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.05) 0%, transparent 50%);
    animation: shimmer 8s ease-in-out infinite alternate;
}

.letters-content {
    width: 100%;
    max-width: 900px;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 40px;
    z-index: 10;
    min-height: 80vh;
}

.letters-slide {
    transition: all 0.8s ease-in-out;
    width: 100%;
}

/* Letter Paper Styling */
.letter-paper {
    backdrop-filter: blur(15px);
    border-radius: 12px;
    padding: 60px 50px;
    max-width: 700px;
    margin: 0 auto;
    position: relative;
    transform: perspective(1000px) rotateX(2deg);
    transition: all 0.3s ease;
    /* Background, colors, and shadows set by theme classes */
}

.letter-paper:hover {
    transform: perspective(1000px) rotateX(0deg);
    /* Shadows set by theme classes */
}

.letter-paper::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
        linear-gradient(90deg, transparent 70px, rgba(220, 180, 140, 0.1) 72px, transparent 74px),
        linear-gradient(0deg, transparent, rgba(220, 180, 140, 0.05) 50%, transparent);
    pointer-events: none;
    border-radius: 15px;
}

/* Letter Body */
.letter-body {
    text-align: center;
    margin-bottom: 40px;
    margin-top: 20px;
}

.letter-greeting {
    font-size: 1.2rem;
    font-weight: 600;
    margin-bottom: 25px;
    color: #5d4037;
}

.letter-message {
    font-size: 1.1rem;
    line-height: 1.8;
    color: #3e2723;
    text-align: center;
    margin-bottom: 20px;
    font-family: Georgia, serif;
    max-width: 580px;
    margin: 0 auto 20px auto;
}

/* Letter Footer */
.letter-footer {
    text-align: center;
    margin-top: 30px;
}

.letter-closing {
    font-size: 1rem;
    color: #5d4037;
    margin-bottom: 30px;
    font-style: italic;
}

.letter-signature {
    position: relative;
}

.letter-from {
    font-size: 2rem;
    font-weight: 700;
    position: relative;
    display: inline-block;
    font-family: 'Brush Script MT', cursive, Georgia, serif;
    transform: rotate(-1deg);
    transition: all 0.3s ease;
    margin-top: 10px;
    letter-spacing: 1px;
    /* Color and text-shadow set by theme classes */
}

.letter-from:hover {
    transform: rotate(0deg) scale(1.08);
    /* Color and text-shadow set by theme classes */
}

.letter-from::after {
    content: '';
    position: absolute;
    bottom: -8px;
    left: -15px;
    right: -15px;
    height: 3px;
    border-radius: 2px;
    animation: signaturePulse 3s ease-in-out infinite;
    /* Background set by theme classes */
}

@keyframes signaturePulse {
    0%, 100% {
        opacity: 0.7;
        transform: scaleX(0.95);
    }
    50% {
        opacity: 1;
        transform: scaleX(1.05);
    }
}

/* Letters Navigation */
.letters-navigation {
    position: absolute;
    bottom: 120px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: 30px;
}

.letters-nav-btn {
    width: 60px;
    height: 60px;
    border: 2px solid rgba(255, 255, 255, 0.6);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    color: white;
    font-size: 1.8rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
}

.letters-nav-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    border-color: white;
    transform: scale(1.1);
    box-shadow: 0 0 20px rgba(255, 255, 255, 0.3);
}

.letters-nav-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
    transform: none;
}

.letters-counter {
    background: rgba(255, 255, 255, 0.1);
    padding: 12px 24px;
    border-radius: 30px;
    font-weight: 600;
    font-size: 1.1rem;
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.2);
}

/* Letters Progress Bar */
.letters-progress-bar {
    position: absolute;
    bottom: 80px;
    left: 50%;
    transform: translateX(-50%);
    width: 300px;
    height: 4px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 2px;
    overflow: hidden;
}

.letters-progress-fill {
    height: 100%;
    background: linear-gradient(90deg, rgba(139, 110, 99, 0.8), rgba(255, 255, 255, 0.9));
    transition: width 0.5s ease;
    border-radius: 2px;
    box-shadow: 0 0 10px rgba(255, 255, 255, 0.5);
}

/* Back to Intro Button */
.back-to-intro-button {
    position: absolute;
    top: 30px;
    left: 30px;
}

.back-intro-btn {
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.3);
    padding: 10px 20px;
    border-radius: 25px;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.3s ease;
    backdrop-filter: blur(10px);
}

.back-intro-btn:hover {
    background: rgba(255, 255, 255, 0.2);
    color: white;
    border-color: rgba(255, 255, 255, 0.6);
}

/* Letters Instructions */
.letters-instructions {
    position: absolute;
    bottom: 10px;
    left: 50%;
    transform: translateX(-50%);
    text-align: center;
    color: rgba(255, 255, 255, 0.7);
    font-size: 0.9rem;
}

/* Responsive Letters Styles */
@media (max-width: 768px) {
    .letters-content {
        padding: 20px;
        min-height: 70vh;
    }

    .letter-paper {
        padding: 40px 30px;
        margin: 20px;
    }

    .letter-greeting {
        font-size: 1.1rem;
        margin-bottom: 20px;
    }

    .letter-message {
        font-size: 1rem;
        line-height: 1.6;
        text-indent: 20px;
    }

    .letter-from {
        font-size: 1.6rem;
    }

    .letters-navigation {
        bottom: 100px;
        gap: 20px;
    }

    .letters-nav-btn {
        width: 50px;
        height: 50px;
        font-size: 1.5rem;
    }

    .letters-counter {
        padding: 10px 20px;
        font-size: 1rem;
    }

    .letters-progress-bar {
        width: 250px;
        bottom: 70px;
    }

    .back-to-intro-button {
        top: 20px;
        left: 20px;
    }

    .skip-intro-button {
        top: 20px;
        right: 20px;
    }

    .back-intro-btn,
    .skip-intro-btn {
        padding: 8px 16px;
        font-size: 0.8rem;
    }
}

@media (max-width: 480px) {
    .letters-content {
        padding: 10px;
        min-height: 65vh;
    }

    .letter-paper {
        padding: 30px 20px;
        margin: 10px;
    }


    .letter-greeting {
        font-size: 1rem;
        margin-bottom: 15px;
    }

    .letter-message {
        font-size: 0.95rem;
        line-height: 1.5;
        text-indent: 15px;
    }

    .letter-footer {
        margin-top: 20px;
    }

    .letter-closing {
        font-size: 0.9rem;
        margin-bottom: 20px;
    }

    .letter-from {
        font-size: 1.4rem;
    }

    .letters-navigation {
        bottom: 80px;
        gap: 15px;
    }

    .letters-nav-btn {
        width: 45px;
        height: 45px;
        font-size: 1.3rem;
    }

    .letters-counter {
        padding: 8px 16px;
        font-size: 0.9rem;
    }

    .letters-progress-bar {
        width: 200px;
        bottom: 60px;
    }

    .back-intro-btn,
    .skip-intro-btn {
        padding: 6px 12px;
        font-size: 0.7rem;
    }
}

/* Responsive Trailer Styles */
@media (max-width: 768px) {
    .trailer-content {
        padding: 20px;
    }

    .trailer-container .intro-icon {
        font-size: 4rem;
        margin-bottom: 20px;
    }

    .trailer-container .intro-title {
        font-size: 2rem;
        margin-bottom: 20px;
        letter-spacing: 2px;
    }

    .trailer-container .intro-text {
        font-size: 1.1rem;
        line-height: 1.6;
    }

    .trailer-navigation {
        bottom: 100px;
        gap: 20px;
    }

    .trailer-nav-btn {
        width: 50px;
        height: 50px;
        font-size: 1.5rem;
    }

    .trailer-counter {
        padding: 10px 20px;
        font-size: 1rem;
    }

    .trailer-progress-bar {
        width: 250px;
        bottom: 70px;
    }

    .trailer-transition-button {
        bottom: 30px;
    }

    .trailer-transition-button .start-letters-btn {
        padding: 15px 30px;
        font-size: 1rem;
    }
}

@media (max-width: 480px) {
    .trailer-container .intro-icon {
        font-size: 3rem;
        margin-bottom: 15px;
    }

    .trailer-container .intro-title {
        font-size: 1.5rem;
        margin-bottom: 15px;
        letter-spacing: 1px;
    }

    .trailer-container .intro-text {
        font-size: 1rem;
        line-height: 1.5;
    }

    .trailer-navigation {
        bottom: 80px;
        gap: 15px;
    }

    .trailer-nav-btn {
        width: 45px;
        height: 45px;
        font-size: 1.3rem;
    }

    .trailer-counter {
        padding: 8px 16px;
        font-size: 0.9rem;
    }

    .trailer-progress-bar {
        width: 200px;
        bottom: 60px;
    }

    .trailer-transition-button {
        bottom: 25px;
    }

    .trailer-transition-button .start-letters-btn {
        padding: 12px 25px;
        font-size: 0.9rem;
    }
}

/* Old card-based styles removed - now using full-screen cinematic experience */

/* Old card-based responsive styles removed */

/* Animation classes for swipe transitions */
.slide-left {
    transform: translateX(-100%);
}

.slide-right {
    transform: translateX(100%);
}

.slide-center {
    transform: translateX(0);
}